# APP_URL: The public URL where this application is hosted.
APP_URL="https://meditradeafrica.org"

# ALLOWED_ORIGINS: Comma-separated list of trusted client origins for CORS policy.
ALLOWED_ORIGINS="https://meditradeafrica.org,https://app.meditradeafrica.org"

# Firebase Admin Service Account Credentials (Production)
FIREBASE_PROJECT_ID="ai-studio-meditradeafrica-23444a66-4e42-4b7a-99c2-c344e082dacf"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Development & Diagnostics Bypasses (MUST be false in production)
ENABLE_DEV_AUTH_BYPASS="false"
ENABLE_DEV_DIAGNOSTICS="false"
VITE_ENABLE_DEV_ADMIN="false"

# File Storage Configuration ('local' or 'gcs')
STORAGE_PROVIDER="local"
GCS_BUCKET_NAME=""

# Malware Scanner Configuration ('basic' or 'clamav')
