# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Admin Service Account Credentials (Production)
# If not provided, Firebase Admin falls back to local development memory mode.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Development Features (MUST be false in production)
VITE_ENABLE_DEV_ADMIN="false"

# File Storage Configuration ('local' or 'gcs')
STORAGE_PROVIDER="local"
GCS_BUCKET_NAME=""
