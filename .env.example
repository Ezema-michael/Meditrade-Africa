# APP_URL: The public URL where this application is hosted.
APP_URL="https://meditradeafrica.org"
NODE_ENV="production"
PORT="3000"
TRUST_PROXY="true"

# ALLOWED_ORIGINS: Comma-separated list of trusted client origins for CORS policy.
ALLOWED_ORIGINS="https://meditradeafrica.org,https://app.meditradeafrica.org"

# Firebase Admin Service Account Credentials (Production)
FIREBASE_PROJECT_ID="meditradeafrica"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Development & Diagnostics Bypasses (MUST be false in production)
ENABLE_DEV_AUTH_BYPASS="false"
ENABLE_DEV_DIAGNOSTICS="false"
VITE_ENABLE_DEV_ADMIN="false"

# File Storage Configuration ('local' or 'gcs')
STORAGE_PROVIDER="gcs"
GCS_BUCKET_NAME="meditradeafrica-private-uploads"

# Escrow bank-transfer destination shown only to authenticated users
BANK_TRANSFER_BANK_NAME="Your regulated banking partner"
BANK_TRANSFER_ACCOUNT_NAME="MediTrade Africa Escrow Collections"
BANK_TRANSFER_ACCOUNT_NUMBER="REPLACE_WITH_PRODUCTION_ACCOUNT"

# Malware Scanner Configuration ('basic' or 'clamav')
MALWARE_SCANNER="clamav"
CLAMAV_HOST="clamav.internal"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="10000"

# GEMINI_API_KEY: Optional key for AI Studio features
GEMINI_API_KEY=""
